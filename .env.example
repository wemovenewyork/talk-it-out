# Copy to .env for local `vercel dev`. Set real values in the Vercel dashboard for deploys.

# Claude API key used by all api/* endpoints
ANTHROPIC_API_KEY=

# Comma-separated CORS allowlist. Same-origin (no Origin header) is always allowed.
ALLOWED_ORIGINS=https://talk-it-out-two.vercel.app

# Optional model overrides (defaults shown in README)
# EXTRACT_FIELDS_MODEL=claude-sonnet-4-6
# MAP_VOICE_MODEL=claude-sonnet-4-6
# SCAN_DOCUMENT_MODEL=claude-sonnet-4-20250514
